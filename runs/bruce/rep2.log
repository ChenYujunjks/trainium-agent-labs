  ---------------- the kernel ----------------
  import nki
  import nki.isa as nisa
  import nki.language as nl

  @nki.jit
  def nki_matmul_basic_(lhsT, rhs):
      # Allocate output buffer in shared HBM
      out = nl.ndarray(shape=(lhsT.shape[1], rhs.shape[1]), dtype=lhsT.dtype, buffer=nl.shared_hbm)
      # Allocate SBUF for the result
      psum = nl.ndarray(shape=(lhsT.shape[1], rhs.shape[1]), dtype=nl.float32, buffer=nl.psum)
      # Allocate SBUF for the stationary (lhsT) and moving (rhs) operands
      sbuf_stationary = nl.ndarray(shape=(lhsT.shape[0], lhsT.shape[1]), dtype=lhsT.dtype, buffer=nl.sbuf)
      sbuf_moving = nl.ndarray(shape=(rhs.shape[0], rhs.shape[1]), dtype=rhs.dtype, buffer=nl.sbuf)
    
      # Copy lhsT to SBUF
      nisa.dma_copy(dst=sbuf_stationary, src=lhsT)
      # Copy rhs to SBUF
      nisa.dma_copy(dst=sbuf_moving, src=rhs)
    
      # Perform matrix multiplication into psum
      nisa.nc_matmul(dst=psum, stationary=sbuf_stationary, moving=sbuf_moving)
    
      # Allocate result tile with exactly the output shape
      res_tile = nl.ndarray(shape=(lhsT.shape[1], rhs.shape[1]), dtype=lhsT.dtype, buffer=nl.sbuf)
      # Copy result from psum to res_tile
      nisa.tensor_copy(dst=res_tile, src=psum)
    
      # Copy result from res_tile to shared HBM
      nisa.dma_copy(dst=out, src=res_tile)
      return out
